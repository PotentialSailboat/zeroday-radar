<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/rss/channel">
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>ZeroDay Radar — RSS Alerts</title><style>body{font:16px system-ui,sans-serif;background:#090f1c;color:#e9eef9;margin:0}main{max-width:820px;margin:48px auto;padding:24px}a{color:#a5c4ff}article{background:#111c30;border:1px solid #334563;border-radius:12px;padding:20px;margin:14px 0}p,small{color:#9aabc6;line-height:1.6}h1{margin-bottom:4px}.help{padding:15px;border:1px solid #334563;border-radius:10px;margin:25px 0}</style></head><body><main><p><a href="./">← Back to dashboard</a></p><h1>ZeroDay Radar · RSS Alerts</h1><p>This is a machine-readable RSS feed with a browser-friendly preview. Subscribe by copying the feed URL into your RSS reader.</p><div class="help"><strong>Subscribe URL:</strong> <code>https://potentialsailboat.github.io/zeroday-radar/feed.xml</code><p>Alerts currently cover newly observed CISA KEV entries and EPSS increases of at least 25 percentage points. New alerts begin after the initial baseline.</p></div>
<xsl:choose><xsl:when test="count(item)=0"><article><h2>No qualifying alerts yet</h2><p>The feed is working, but no alert events have been recorded since the initial baseline. You can still subscribe now.</p></article></xsl:when><xsl:otherwise><xsl:for-each select="item"><article><h2><a href="{link}"><xsl:value-of select="title"/></a></h2><small><xsl:value-of select="pubDate"/></small><p><xsl:value-of select="description"/></p></article></xsl:for-each></xsl:otherwise></xsl:choose>
<p><a href="./alerts.html">Open interactive alert history</a></p></main></body></html>
</xsl:template></xsl:stylesheet>
